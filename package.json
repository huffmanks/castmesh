{
  "name": "@castmesh",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:desktop": "vp run --filter @castmesh/desktop tauri:dev",
    "dev:tizen": "vp run --filter @castmesh/tizen-tv dev",
    "build:packages": "vp run --filter @castmesh/core build && vp run --filter @castmesh/react build",
    "build:desktop": "vp run --filter @castmesh/desktop tauri:build",
    "build:tizen": "vp run --filter @castmesh/tizen-tv build",
    "check:fix": "vp check --fix",
    "test:watch": "vp test watch"
  },
  "devDependencies": {
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.16.1",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=24.18.0"
  }
}
